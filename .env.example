# Rosie Atelier — environment variables (copy to .env.local for development or production)

# ── Admin panel (REQUIRED in production) ────────────────────────────────
# Without these two, /api/auth/login returns 401 "admin_not_configured" in production.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# HMAC key for the session cookie. Any long random string, e.g. `openssl rand -hex 32`.
# If unset, ADMIN_PASSWORD is used as the signing key — set a dedicated one.
AUTH_SECRET=

# ── Content persistence ────────────────────────────────────────────────
# Option 1: Upstash Redis for shared or persistent deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# With neither, content falls back to ./data/content.json.

# ── Canonical site URL (used by sitemap.xml, robots.txt and OG metadata) ─
# Set this to your public URL WITHOUT a trailing slash.
NEXT_PUBLIC_SITE_URL=
